generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All four channels are *simulated* by the channel service — never a real provider.
enum Channel {
  whatsapp
  sms
  email
  rcs
}

// Lifecycle moves strictly forward; `failed` is a terminal branch off `sent`.
// The /receipt handler must never regress status (a late "delivered" can't overwrite "read").
enum CommStatus {
  queued
  sent
  delivered
  failed
  opened
  read
  clicked
  converted
}

enum CampaignStatus {
  draft
  launching
  sent
  completed
}

model User {
  id           String     @id @default(uuid())
  googleId     String?    @unique @map("google_id")
  email        String     @unique
  passwordHash String?    @map("password_hash")
  name         String?
  avatarUrl    String?    @map("avatar_url")
  createdAt    DateTime   @default(now()) @map("created_at")

  campaigns    Campaign[]
  datasets     Dataset[]

  @@map("users")
}

// A campaign launched over an uploaded dataset.
model Campaign {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  name            String
  channel         Channel
  messageTemplate String         @map("message_template")
  status          CampaignStatus @default(draft)
  createdAt       DateTime       @default(now()) @map("created_at")

  datasetId       String?        @map("dataset_id")
  contactColumn   String?        @map("contact_column")
  audienceSql     String?        @map("audience_sql")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset         Dataset?        @relation(fields: [datasetId], references: [id])
  communications  Communication[]

  @@index([userId])
  @@map("campaigns")
}

// One row per (campaign x recipient). Timestamp-per-stage lets us compute the funnel with COUNTs.
model Communication {
  id              String     @id @default(uuid())
  campaignId      String     @map("campaign_id")
  channel         Channel
  renderedMessage String     @map("rendered_message")
  status          CommStatus @default(queued)

  contact         String?                              // snapshot of email/phone sent to
  datasetRowId    String?    @map("dataset_row_id")   // source row reference

  sentAt          DateTime?  @map("sent_at")
  deliveredAt     DateTime?  @map("delivered_at")
  failedAt        DateTime?  @map("failed_at")
  openedAt        DateTime?  @map("opened_at")
  readAt          DateTime?  @map("read_at")
  clickedAt       DateTime?  @map("clicked_at")
  convertedAt     DateTime?  @map("converted_at")

  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  receipts        Receipt[]

  @@index([campaignId])
  @@index([status])
  @@map("communications")
}

// Append-only callback log → gives idempotency + audit trail for the channel loop.
model Receipt {
  id              String   @id @default(uuid())
  communicationId String   @map("communication_id")
  eventType       String   @map("event_type")
  payload         Json     @default("{}")
  receivedAt      DateTime @default(now()) @map("received_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@map("receipts")
}

// A user-uploaded dataset (e.g. a CSV). The tenancy boundary — each belongs to one user.
model Dataset {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  rowCount  Int             @default(0) @map("row_count")
  createdAt DateTime        @default(now()) @map("created_at")

  columns   DatasetColumn[]
  rows      DatasetRow[]
  campaigns Campaign[]

  @@index([userId])
  @@map("datasets")
}

// The inferred schema of a dataset — one row per column. This is what the AI reads to adapt.
model DatasetColumn {
  id           String   @id @default(uuid())
  datasetId    String   @map("dataset_id")
  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name         String
  key          String
  type         String
  position     Int
  sampleValues String[] @map("sample_values")

  @@unique([datasetId, key])
  @@index([datasetId])
  @@map("dataset_columns")
}

// One row of a dataset, stored generically as JSON so any schema works.
model DatasetRow {
  id        String  @id @default(uuid())
  datasetId String  @map("dataset_id")
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  data      Json

  @@index([datasetId])
  @@map("dataset_rows")
}