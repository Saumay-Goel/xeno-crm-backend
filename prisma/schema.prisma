generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All four channels are *simulated* by the channel service — never a real provider.
enum Channel {
  whatsapp
  sms
  email
  rcs
}

// Lifecycle moves strictly forward; `failed` is a terminal branch off `sent`.
// The /receipt handler must never regress status (a late "delivered" can't overwrite "read").
enum CommStatus {
  queued
  sent
  delivered
  failed
  opened
  read
  clicked
  converted
}

enum CampaignStatus {
  draft
  launching
  sent
  completed
}

// The marketer who logs in (Google OAuth). Owns the segments + campaigns they create.
// Customers/orders are NOT owned by a user — they're the brand's shared shopper base.
model User {
  id           String   @id @default(uuid())
  googleId     String?  @unique @map("google_id")   // now optional
  email        String   @unique
  passwordHash String?  @map("password_hash")        // null for Google users
  name         String?
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  segments  Segment[]
  campaigns Campaign[]

  @@map("users")
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String?
  city       String?
  attributes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  orders         Order[]
  communications Communication[]

  @@index([city])
  @@map("customers")
}

model Order {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  amount     Decimal  @db.Decimal(10, 2)
  items      Json     @default("[]")
  orderedAt  DateTime @map("ordered_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderedAt])
  @@map("orders")
}

// rules = structured segment tree (from manual builder OR AI). Engine translates to SQL.
// Owned by the marketer who created it.
model Segment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  rules     Json
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([userId])
  @@map("segments")
}

// Owned by the marketer who launched it.
model Campaign {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  name            String
  segmentId       String         @map("segment_id")
  channel         Channel
  messageTemplate String         @map("message_template")
  status          CampaignStatus @default(draft)
  createdAt       DateTime       @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment        Segment         @relation(fields: [segmentId], references: [id])
  communications Communication[]

  @@index([userId])
  @@map("campaigns")
}

// One row per (campaign x customer). Timestamp-per-stage lets us compute the funnel with COUNTs.
model Communication {
  id              String     @id @default(uuid())
  campaignId      String     @map("campaign_id")
  customerId      String     @map("customer_id")
  channel         Channel
  renderedMessage String     @map("rendered_message")
  status          CommStatus @default(queued)
  sentAt          DateTime?  @map("sent_at")
  deliveredAt     DateTime?  @map("delivered_at")
  failedAt        DateTime?  @map("failed_at")
  openedAt        DateTime?  @map("opened_at")
  readAt          DateTime?  @map("read_at")
  clickedAt       DateTime?  @map("clicked_at")
  convertedAt     DateTime?  @map("converted_at")

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  receipts Receipt[]

  @@index([campaignId])
  @@index([status])
  @@map("communications")
}

// Append-only callback log → gives idempotency + audit trail for the channel loop.
model Receipt {
  id              String   @id @default(uuid())
  communicationId String   @map("communication_id")
  eventType       String   @map("event_type")
  payload         Json     @default("{}")
  receivedAt      DateTime @default(now()) @map("received_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@map("receipts")
}