# ── Database (Neon) ──
# Pooled connection (runtime) — host contains "-pooler"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection (migrations) — no "-pooler"
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Server ──
PORT=4000
NODE_ENV=development
# Frontend origin for CORS (leave unset in dev = allow all; set to Vercel URL in prod)
# CORS_ORIGIN=https://your-app.vercel.app

# ── Queue (Redis / Upstash) ──
# Local:   redis://localhost:6379
# Upstash: rediss://default:PASSWORD@your-db.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Channel service ──
CHANNEL_SERVICE_URL=http://localhost:4001
# Must match CALLBACK_SECRET in the channel service's .env exactly
CALLBACK_SECRET=dev-shared-secret-change-me

# ── AI (Gemini) — used in Step 8 ──
GEMINI_API_KEY=